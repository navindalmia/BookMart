@model UserRoleVM

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-black py-2">Manage User Role</h2>
            </div>
        </div>
    </div>

    @* body *@
    <div class="card-body p-4">
        <form method="post" action="UpdateUserRole" class="row" enctype="multipart/form-data">
            <input asp-for="ApplicationUser.Id" hidden />

            <div class="row">
                <div class="col-12">
                    <div class="border p-3">
                        <div class="form-floating py-2 col-12">
                            <input asp-for="ApplicationUser.Name" class="form-control border-0 shadow" readonly />
                            <label asp-for="ApplicationUser.Name" class="ms-2"> </label>
                            <span asp-validation-for="ApplicationUser.Name" class="text-danger"></span>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <select id="roleDropdown" asp-for="SelectedRoleId" asp-items="@Model.RoleList" class="form-select">
                                <option disabled selected>-Select Role-</option>

                            </select>

                            <label asp-for="SelectedRoleId" class="ms-2">Role</label>
                        </div>

                        <div id="companyField" class="form-floating py-2 col-12" style="display:none">
                            <label class="ms-2"  asp-for="SelectedCompanyId">Company</label>
                            <select id="companyDropdown" asp-for="SelectedCompanyId" asp-items="@Model.CompanyList" class="form-select">
                                <option disabled selected>-Select Company-</option>

                            </select>
                        </div>


                       @*   <div id="companyField" class="form-floating py-2 col-12" style="display:none">
                             <label asp-for="ApplicationUser.Company.Name">Company Name</label>
                             <input asp-for="ApplicationUser.Company.Name" class="form-control" />
                             <span asp-validation-for="ApplicationUser.Company.Name" class="text-danger"></span>
                         </div> *@


                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                <button type="submit" class="btn btn-primary form-control"> Update Role</button>

                            </div>
                          
                        </div>
                        <div asp-validation-summary="All"></div>



                    </div>

                </div>


            </div>


        </form>

    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dropdown = document.getElementById("roleDropdown");
            const companyField = document.getElementById("companyField");

            function toggleCompanyField() {
                const selectedText = dropdown.options[dropdown.selectedIndex]?.text;
                if (selectedText?.toLowerCase() === "company") {
                    companyField.style.display = "block";
                } else {
                    companyField.style.display = "none";
                }
            }

            // run once on page load
            toggleCompanyField();

            // run on change
            dropdown.addEventListener("change", toggleCompanyField);
        });
    </script>
}